<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!-- 产品：单一 MSI，含 3 个互斥可选组件（Propel / Repel / Impel），版本 V1.0.0 -->
  <Package Name="MenuClient 安装程序"
           Language="2052"
           Version="1.0.0"
           Manufacturer="MenuClient"
           UpgradeCode="3F8A2C1E-7B4D-4E9F-8A1C-2D6E5F0B9C3A"
           InstallerVersion="500"
           Compressed="yes"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="已安装更高版本，无法继续安装。" />
    <MediaTemplate />

    <!-- 安装到系统盘 Program Files 下的三个独立目录 -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="PROPELFOLDER" Name="Propel" />
      <Directory Id="REPELFOLDER" Name="Repel" />
      <Directory Id="IMPELFOLDER" Name="Impel" />
    </StandardDirectory>

    <!-- 单一 Feature 承载全部组件，具体安装哪一个由组件 Condition + ROLE 决定 -->
    <Feature Id="FMain" Title="MenuClient 组件" Level="1" Description="根据安装时的选择安装 Propel / Repel / Impel 其中之一。">
      <ComponentRef Id="CPropel" />
      <ComponentRef Id="CRepel" />
      <ComponentRef Id="CImpel" />
    </Feature>

    <!-- 选择结果（单选）：PROPEL / REPEL / IMPEL -->
    <Property Id="ROLE" Secure="yes" />

    <!-- ===== Propel 组件（仅当 ROLE=PROPEL） ===== -->
    <Component Id="CPropel" Guid="A1B2C3D4-0001-4000-8000-000000000001" Directory="PROPELFOLDER" Condition="ROLE = 'PROPEL'">
      <File Source="..\dist\propel\PropelControl.exe" KeyPath="yes" />
      <File Source="..\dist\propel\PropelControl.exe.config" />
      <File Source="..\dist\propel\PropelService.exe" />
      <File Source="..\dist\propel\PropelService.exe.config" />
      <File Source="..\dist\propel\Propel.dll" />
      <File Source="..\dist\propel\propel.json" />
    </Component>

    <!-- ===== Repel 组件（仅当 ROLE=REPEL） ===== -->
    <Component Id="CRepel" Guid="A1B2C3D4-0002-4000-8000-000000000002" Directory="REPELFOLDER" Condition="ROLE = 'REPEL'">
      <File Source="..\dist\repel\RepelControl.exe" KeyPath="yes" />
      <File Source="..\dist\repel\RepelControl.exe.config" />
      <File Source="..\dist\repel\RepelService.exe" />
      <File Source="..\dist\repel\RepelService.exe.config" />
      <File Source="..\dist\repel\repelView.exe" />
      <File Source="..\dist\repel\Repel.dll" />
      <File Source="..\dist\repel\repel.json" />
      <File Source="..\dist\repel\repel.lst" />
    </Component>

    <!-- ===== Impel 组件（仅当 ROLE=IMPEL） ===== -->
    <Component Id="CImpel" Guid="A1B2C3D4-0003-4000-8000-000000000003" Directory="IMPELFOLDER" Condition="ROLE = 'IMPEL'">
      <File Source="..\dist\impel\impel.exe" KeyPath="yes" />
      <File Source="..\dist\impel\impel.exe.config" />
      <File Source="..\dist\impel\impel.dll" />
      <File Source="..\dist\impel\Impel.json" />
    </Component>

    <!-- ===== 自定义界面（纯核心 WiX，无扩展依赖） ===== -->
    <UI Id="MyUI">
      <TextStyle Id="T1" FaceName="Segoe UI" Size="9" />
      <Property Id="DefaultUIFont" Value="T1" />

      <!-- 选择对话框：单选 RadioButtonGroup，天然互斥（三者只能选其一） -->
      <Dialog Id="SelDlg" Width="370" Height="270" Title="选择要安装的组件" NoMinimize="yes">
        <Control Id="Banner" Type="Text" X="0" Y="0" Width="370" Height="44" Text="MenuClient 安装程序 - V1.0.0" Transparent="yes" NoPrefix="yes" />
        <Control Id="Body" Type="Text" X="20" Y="60" Width="330" Height="40"
                 Text="请选择要安装的组件（Propel 服务器 / Repel 服务器 / Impel 客户端，三者只能安装其一）：" />
        <Control Id="Role" Type="RadioButtonGroup" X="20" Y="110" Width="330" Height="90"
                 Property="ROLE" Text="选择组件">
          <RadioButtonGroup Property="ROLE">
            <RadioButton Value="PROPEL" X="10" Y="0"  Width="300" Height="22" Text="Propel 服务器（安装到 Program Files\Propel）" />
            <RadioButton Value="REPEL" X="10" Y="28" Width="300" Height="22" Text="Repel 服务器（安装到 Program Files\Repel）" />
            <RadioButton Value="IMPEL" X="10" Y="56" Width="300" Height="22" Text="Impel 客户端（安装到 Program Files\Impel）" />
          </RadioButtonGroup>
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="下一步(&amp;N)">
          <Publish Event="SpawnDialog" Value="NoSelDlg" Condition="NOT ROLE" />
          <Publish Event="NewDialog"  Value="InstallDlg" Condition="ROLE" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="取消(&amp;C)">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <!-- 未选择提示 -->
      <Dialog Id="NoSelDlg" Width="260" Height="120" Title="提示" NoMinimize="yes">
        <Control Id="Text" Type="Text" X="20" Y="20" Width="220" Height="40"
                 Text="请先选择一个组件（Propel / Repel / Impel 只能选其一）。" />
        <Control Id="Ok" Type="PushButton" X="102" Y="80" Width="56" Height="17" Default="yes" Text="确定">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <!-- 安装对话框：包含安装按钮 + 进度条 + 完成按钮 -->
      <Dialog Id="InstallDlg" Width="370" Height="270" Title="正在安装" NoMinimize="yes">
        <Control Id="Banner" Type="Text" X="0" Y="0" Width="370" Height="44" Text="MenuClient 安装程序" Transparent="yes" NoPrefix="yes" />
        <Control Id="Bar" Type="ProgressBar" X="20" Y="90" Width="330" Height="20" />
        <Control Id="ActionText" Type="Text" X="20" Y="120" Width="330" Height="40" Text="[ActionText]" />
        <Control Id="Install" Type="PushButton" X="180" Y="243" Width="56" Height="17" Default="yes" Text="安装(&amp;I)">
          <Publish Event="DoAction" Value="ExecuteAction" />
        </Control>
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Text="完成(&amp;F)">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="取消(&amp;C)">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <InstallUISequence>
        <Show Dialog="SelDlg" Before="ExecuteAction" />
      </InstallUISequence>
    </UI>

  </Package>
</Wix>
