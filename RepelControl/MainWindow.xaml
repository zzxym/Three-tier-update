<Window x:Class="RepelControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="天一网络三层更新网吧服务端" Width="640" Height="620" MinHeight="560" MinWidth="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        FontFamily="Microsoft YaHei, 微软雅黑" FontSize="13"
        Background="#EFF3F9">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.12" Color="#1B2A4A"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1F2D3D"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#52607A"/>
        </Style>
        <Style x:Key="Txt" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D7DEEA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FBFCFE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="4,2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Pwd" TargetType="PasswordBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D7DEEA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FBFCFE"/>
            <Setter Property="PasswordChar" Value="●"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="4,2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinWidth" Value="108"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#E9EDF3"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#D4DCEC"/>
                                <Setter Property="Foreground" Value="#9AA3B2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnSec" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2B3A55"/>
            <Setter Property="BorderBrush" Value="#D4DCEC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="LogBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#1E2230"/>
            <Setter Property="Foreground" Value="#C9D4E6"/>
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 服务参数 -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <TextBlock Text="服务参数" Style="{StaticResource CardTitle}"/>
                    <Button x:Name="btnWriteCfg" Content="保存配置" Style="{StaticResource BtnSec}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnWriteCfg_Click"/>
                </Grid>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="监听端口：" Style="{StaticResource FieldLabel}" Margin="0,0,12,0"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtPort" Text="80" Style="{StaticResource Txt}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="缓存目录：" Style="{StaticResource FieldLabel}" Margin="12,0,12,0"/>
                    <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtCache" Text="cache" Style="{StaticResource Txt}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Propel 服务器：" Style="{StaticResource FieldLabel}" Margin="0,10,12,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="txtSource" Text="https://propel.xiaolin.cc:81" Style="{StaticResource Txt}" Margin="0,10,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="鉴权 tokens：" Style="{StaticResource FieldLabel}" Margin="0,10,12,0"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="txtTokens" Style="{StaticResource Txt}" Margin="0,10,0,0"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="管理密钥：" Style="{StaticResource FieldLabel}" Margin="0,10,12,0"/>
                    <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox Grid.Column="0" x:Name="pwdAdminToken" Style="{StaticResource Pwd}"
                                     ToolTip="仅在需要修改密钥时输入；留空表示保持 repel.json 中已有的密钥，界面不会回显。"/>
                        <TextBlock Grid.Column="1" x:Name="lblAdminTokenState" Text="未配置" Margin="10,0,0,0"
                                   VerticalAlignment="Center" Foreground="#52607A" FontSize="12"/>
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 服务管理 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="服务管理" Style="{StaticResource CardTitle}"/>
                <UniformGrid Columns="4" Margin="0,10,0,0">
                    <Button x:Name="btnLst" Content="菜单管理" Style="{StaticResource BtnSec}" Margin="0,0,6,0" Click="BtnLst_Click"/>
                    <Button x:Name="btnTest" Content="测试连接" Style="{StaticResource BtnSec}" Margin="6,0" Click="BtnTest_Click"/>
                    <Button x:Name="btnInstall" Content="安装服务" Style="{StaticResource BtnSec}" Margin="6,0" Click="BtnInstall_Click"/>
                    <Button x:Name="btnStart" Content="启动服务" Style="{StaticResource BtnSec}" Margin="6,0,0,0" Click="BtnStart_Click"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- 运行日志 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="运行日志" Style="{StaticResource CardTitle}"/>
                <TextBox Grid.Row="1" x:Name="txtLog" Style="{StaticResource LogBox}" Margin="0,8,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
